{
  "name": "quizr",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo start --go --android",
    "ios": "expo start --go --ios",
    "web": "expo start --web --port 8081",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e",
    "lint": "expo lint --max-warnings 0",
    "format": "prettier --write .",
    "test": "jest",
    "check": "bun run typecheck && bun run lint && bun run test",
    "db:generate": "drizzle-kit generate",
    "e2e:web": "playwright test",
    "e2e:android": "maestro test e2e/maestro",
    "build:web": "expo export --platform web",
    "android:build": "expo run:android"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "expo": "~58.0.25",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-font": "~58.0.12",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.31",
    "expo-speech": "~58.0.4",
    "expo-splash-screen": "~58.0.14",
    "expo-sqlite": "~58.0.17",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "ts-fsrs": "~5.4.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "~19.3.0",
    "babel-plugin-inline-import": "^3.0.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "fast-check": "^4.10.2",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/e2e/",
      "/dist/",
      "/android/",
      "/ios/",
      "/src/app/"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/data/migrations/**",
      "!src/app/**"
    ]
  }
}
